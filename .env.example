# REQUIRED

# Discord webhook URL for the channel the announcement should go to.
# Discord > Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000/xxxxxxxx

# Your YouTube channel. Use the channel ID (starts with UC) or your @handle.
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YT_CHANNEL_HANDLE=@yourhandle

# YouTube Data API v3 key. Free. Needed for a reliable live check and for the
# channel picture and description on the card. Costs about 2 quota units per
# check, and the free daily quota is 10000 units.
# Create one at https://console.cloud.google.com/apis/credentials
YT_API_KEY=


# RECOMMENDED

# Password that protects /cron, /test, /state and /reset. Without it those
# endpoints stay switched off. Use at least 16 random characters, and never
# commit the real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=


# MESSAGE

# Available placeholders: {title} {url} {videoId} {channel} {thumbnail} {startedAt}
MESSAGE_TEMPLATE={channel} is live now!\n{title}\n{url}

# Added in front of the message. Use @everyone, @here, or <@&ROLE_ID> to ping a
# role. Leave blank for no ping.
MENTION=

# Send a rich embed with the thumbnail alongside the text.
USE_EMBED=true
EMBED_COLOR=16711680

# Include the stream description in the embed. Needs YT_API_KEY, since the
# public page does not expose it.
SHOW_DESCRIPTION=true

# Override the webhook display name and avatar. Optional.
WEBHOOK_USERNAME=
WEBHOOK_AVATAR_URL=


# BEHAVIOR

# How often the service checks whether you are live, in seconds.
POLL_INTERVAL_SECONDS=300

# The service keeps itself awake by pinging its own address, so free hosting
# does not put it to sleep. Render fills this in automatically, so leave it
# blank there. Set it only if your host does not provide a public URL.
SELF_URL=

# How often the self ping runs. Keep it under your host's idle timeout, which
# is 15 minutes on Render.
KEEPALIVE_SECONDS=600

# If the first check after a restart finds a stream already live, announce it?
# Keep false so a redeploy does not repeat an announcement.
ANNOUNCE_ON_FIRST_RUN=false

# Where the list of already announced streams is stored.
STATE_FILE=./data/state.json

PORT=3000
